---
import Base from '../layouts/Base.astro';
import { site } from '../site';
const configurato = !site.formEndpoint.includes('INCOLLA-QUI');
---
<Base titolo="Contatti">
  <p class="eyebrow">Contatti</p>
  <h1>Parliamone</h1>
  <p class="lead">Se vuoi collaborare, confrontarti su un'idea o semplicemente salutare, scrivimi.</p>

  {configurato ? (
    <form id="contatto" class="form" action={site.formEndpoint} method="POST">
      <label>Nome
        <input type="text" name="nome" required autocomplete="name" />
      </label>
      <label>Email per la risposta
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>Messaggio
        <textarea name="messaggio" rows="6" required></textarea>
      </label>
      <!-- Campo trappola anti-spam: gli utenti non lo vedono -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
      <button class="btn" type="submit">Invia messaggio</button>
      <p id="esito" role="status" aria-live="polite"></p>
    </form>
    <script is:inline>
      const f = document.getElementById('contatto');
      const esito = document.getElementById('esito');
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        esito.textContent = 'Invio in corso…';
        try {
          const r = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } });
          if (r.ok) { f.reset(); esito.textContent = 'Grazie! Messaggio inviato, ti rispondo presto.'; }
          else { esito.textContent = 'Qualcosa è andato storto. Riprova o scrivimi su LinkedIn.'; }
        } catch { esito.textContent = 'Errore di rete. Riprova o scrivimi su LinkedIn.'; }
      });
    </script>
  ) : (
    <p class="card"><strong>Form non ancora attivo.</strong> Segui le istruzioni nel README (sezione "Form contatti") e incolla l'endpoint in <code>src/site.ts</code>.</p>
  )}

  <h2>Oppure trovami qui</h2>
  <div class="grid">
    <a class="card" href={site.linkedin} style="text-decoration:none;color:inherit"><h3>LinkedIn</h3><p>Il mio profilo professionale</p></a>
    <a class="card" href={site.github} style="text-decoration:none;color:inherit"><h3>GitHub</h3><p>Codice e side project</p></a>
  </div>
</Base>

<style is:global>
  .form { display:grid; gap:1rem; max-width:32rem; margin-top:2rem; }
  .form label { display:grid; gap:.35rem; font-weight:600; font-size:.95rem; }
  .form input, .form textarea { font:inherit; padding:.65rem .8rem; border:1px solid var(--line); border-radius:8px; background:var(--card); color:var(--fg); }
  .form input:focus, .form textarea:focus { outline:2px solid var(--accent); outline-offset:1px; }
  .form button { justify-self:start; border:0; cursor:pointer; font:inherit; font-weight:600; }
  #esito { margin:0; color:var(--muted); }
</style>
