---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const progetti = (await getCollection('progetti')).sort((a, b) => a.data.ordine - b.data.ordine);
---
<Base titolo="Progetti">
  <p class="eyebrow">Progetti</p>
  <h1>Cosa ho costruito</h1>
  <p class="lead">Side project, esperimenti e repository. Aggiungine uno creando un file Markdown in <code>src/content/progetti</code>.</p>
  <div class="grid" style="margin-top:2rem">
    {progetti.map((p) => (
      <a class="card" href={`${base}/progetti/${p.id}`} style="text-decoration:none;color:inherit">
        <span class="eyebrow">{p.data.stato}</span>
        <h3>{p.data.titolo}</h3>
        <p>{p.data.descrizione}</p>
        <ul class="tags">{p.data.tecnologie.map((t) => <li>{t}</li>)}</ul>
      </a>
    ))}
  </div>
</Base>
