---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Modifica qui prezzi e durata.
const prezzi = {
  oraSingola: 60,
  percorso: 165, // 3 incontri da 60 minuti
  primaCallMinuti: 30,
};
const nIncontri = 3;
const risparmio = prezzi.oraSingola * nIncontri - prezzi.percorso;
const contatto = (testo: string) => `${base}/contatti?messaggio=${encodeURIComponent(testo)}`;

const domande = [
  'Cosa fa davvero uno Scrum Master, nella pratica di tutti i giorni?',
  'Quali competenze bisogna sviluppare?',
  'Quali certificazioni scegliere?',
  'Come si applica Scrum nella realtà di un\'azienda?',
  'Come si passa dalla teoria alla pratica?',
];

const aree = [
  'Capire il ruolo e le sue responsabilità',
  'Individuare le soft skill da sviluppare',
  'Definire cosa studiare e quali certificazioni valutare',
  'Capire come fare esperienza nel tuo contesto di lavoro',
  'Costruire una roadmap personale per entrare nel mondo Agile',
];

const incontri = [
  { titolo: 'Il ruolo e le competenze', punti: ['Chi è lo Scrum Master e cosa fa davvero ogni giorno', 'Differenze con Project Manager e Product Owner', 'Le competenze da sviluppare: facilitazione, comunicazione, servant leadership, gestione dei conflitti, coaching'] },
  { titolo: 'Studiare e fare esperienza', punti: ['Cosa studiare: Scrum Guide, Agile Manifesto, risorse e libri', 'Certificazioni: come orientarsi e scegliere', 'Come avvicinarti al ruolo e applicare Scrum nel tuo contesto, anche senza il titolo'] },
  { titolo: 'La tua roadmap', punti: ['Come valorizzare le esperienze che hai già', 'CV, LinkedIn e preparazione ai colloqui', 'Un piano di sviluppo a 3-6 mesi, con obiettivi e passi concreti'] },
];
---
<Base titolo="Mentoring per aspiranti Scrum Master" descrizione="Percorso individuale di mentoring per chi vuole diventare Scrum Master: ruolo, competenze, certificazioni e roadmap personale. Prima consulenza gratuita.">
  <p class="eyebrow">Mentoring</p>
  <h1>Vuoi diventare Scrum Master ma non sai da dove iniziare?</h1>
  <p class="lead">Forse lavori già nel mondo IT, come Developer, Tester, Business Analyst o Project Manager, e stai pensando a un percorso in ambito Agile. Ti aiuto a capire come arrivarci.</p>
  <p style="margin-top:1.5rem">
    <a class="btn" href={contatto('Ciao Chiara, vorrei prenotare la prima consulenza gratuita di mentoring per aspiranti Scrum Master. Il mio punto di partenza è: ')}>Prenota la prima consulenza gratuita</a>
  </p>

  <h2>Ti riconosci in queste domande?</h2>
  <ul class="prose">
    {domande.map((d) => <li>{d}</li>)}
  </ul>

  <div class="prose">
    <p>Ho pensato un percorso individuale di mentoring, costruito sull'esperienza pratica e non su un corso teorico. Insieme possiamo:</p>
    <ul>{aree.map((a) => <li>{a}</li>)}</ul>
    <p><strong>Non è una preparazione a una certificazione ufficiale.</strong> È un percorso di orientamento e di crescita professionale: il primo passo per diventare Scrum Master è capire come arrivarci.</p>
  </div>

  <h2>Chi ti accompagna</h2>
  <div class="prose">
    <p>Sono una Senior Scrum Master, certificata CSM, PSM I e ICP-ATF (facilitazione di team agili), e lavoro oggi come facilitatrice di team e leadership in un contesto internazionale. Il mio percorso non è lineare: vengo dalla Fisica e dalla ricerca, ho lavorato su progetti IT e di prodotto e poi sono arrivata ad Agile. So quanto può sembrare confuso il passaggio, e quanto un confronto con chi ci è già passata aiuti a orientarsi.</p>
  </div>

  <h2>Il percorso in {nIncontri} incontri</h2>
  <div class="timeline">
    {incontri.map((i, n) => (
      <article>
        <span class="when">Incontro {n + 1}</span>
        <h3>{i.titolo}</h3>
        <ul>{i.punti.map((p) => <li>{p}</li>)}</ul>
      </article>
    ))}
  </div>

  <h2>Formule e prezzi</h2>
  <div class="grid">
    <section class="card">
      <span class="eyebrow">Per iniziare</span>
      <h3>Prima consulenza gratuita</h3>
      <p>{prezzi.primaCallMinuti} minuti per conoscerci, capire il tuo punto di partenza e vedere se il percorso fa per te e se ti trovi bene con il mio modo di lavorare. Senza impegno.</p>
      <a class="btn sec" href={contatto('Ciao Chiara, vorrei prenotare la prima consulenza gratuita. ')}>Prenota</a>
    </section>
    <section class="card">
      <span class="eyebrow">Singolo incontro</span>
      <h3>{prezzi.oraSingola} € <small style="font-weight:400;font-size:.9rem">/ 60 minuti</small></h3>
      <p>Un confronto mirato su un tema preciso: il ruolo, il CV, un colloquio, una situazione che stai vivendo.</p>
      <a class="btn sec" href={contatto('Ciao Chiara, vorrei prenotare un singolo incontro di mentoring (60 minuti). ')}>Richiedi</a>
    </section>
    <section class="card">
      <span class="eyebrow">Percorso completo</span>
      <h3>{prezzi.percorso} € <small style="font-weight:400;font-size:.9rem">/ {nIncontri} incontri da 60 minuti</small></h3>
      <p>Tutto il percorso, fino alla tua roadmap personale. Risparmi {risparmio} € rispetto a {nIncontri} incontri singoli.</p>
      <a class="btn" href={contatto(`Ciao Chiara, vorrei informazioni sul percorso di mentoring in ${nIncontri} incontri. `)}>Richiedi</a>
    </section>
  </div>

  <h2>Domande frequenti</h2>
  <div class="prose">
    <h3>Serve già esperienza di Agile?</h3>
    <p>No. Il percorso funziona sia per chi lavora già in un contesto IT e vuole cambiare ruolo, sia per chi si avvicina per la prima volta al mondo Agile.</p>
    <h3>Come si svolgono gli incontri?</h3>
    <p>In videochiamata, uno a uno. Prima di ogni incontro ci accordiamo sul tema, e alla fine ricevi i passi concreti da fare.</p>
    <h3>Mi garantisci un posto di lavoro o la certificazione?</h3>
    <p>No: il percorso ti dà metodo, chiarezza e un piano. Il risultato dipende dal lavoro che fai e dal mercato.</p>
  </div>

  <p style="margin-top:2rem">
    <a class="btn" href={contatto('Ciao Chiara, vorrei prenotare la prima consulenza gratuita di mentoring per aspiranti Scrum Master. Il mio punto di partenza è: ')}>Scrivimi per iniziare</a>
  </p>
</Base>
