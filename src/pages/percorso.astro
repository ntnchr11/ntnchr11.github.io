---
import Base from '../layouts/Base.astro';
const esperienze = [
  { quando: '2025 – oggi', ruolo: 'Facilitator, Scrum Master', dove: 'Eurobet, Entain Italia', punti: [
    'Facilito il processo decisionale strategico tra Leadership e funzioni per identificare valore e ricavo atteso.',
    'Realizzo roadmap e dashboard di avanzamento a livello di tribe; costruisco con team e Product Owner roadmap ibride a milestone e rolling wave.',
    'Progetto e conduco workshop con Executive e Leadership per ridurre i silos e migliorare i processi decisionali.',
    'Coordino team cross-funzionali in contesto internazionale e faccio leadership coaching sull\'allineamento strategico.',
    'Lavoro con le principali metriche agili in uso in azienda per individuare le aree di miglioramento di team e processi.'] },
  { quando: '2024 – 2025', ruolo: 'Scrum Master', dove: 'Dot Beyond', punti: [
    'Sono stata Scrum Master di tre team (Aree Musei & Innovazione e Turismo): ho facilitato tutti gli eventi Scrum, con obiettivi di Sprint SMART e un tasso di completamento degli sprint migliorato del 35%.',
    'Ho affiancato i Product Owner nella pianificazione della roadmap: stime del backlog più accurate (almeno +20%) e consegna puntuale degli elementi prioritari aumentata del 30%.',
    'Ho lavorato con domain expert e Product Owner sulla qualità delle user story: casi di ambiguità ridotti del 40%.',
    'Ho coordinato stakeholder interni ed esterni: oltre 20 interazioni cross-team facilitate, con tempi di attesa per risorse esterne ridotti del 30%.',
    'Ho fatto coaching per superare gli antipattern più comuni (backlog refinement insufficiente, dipendenze non gestite), con processi agili sempre più maturi.',
    'Ho collaborato alla progettazione e alla conduzione di corsi interni su Agile, Lean e Scrum, in aula e on the job, per oltre 60 partecipanti tra team e funzioni di supporto.'] },
  { quando: '2023 – 2024', ruolo: 'Scrum Master and Product Manager', dove: 'Dot Beyond', punti: [
    'Sono stata Scrum Master di due team dell\'Area Musei e di uno dell\'Area Piattaforme Digitali: ho monitorato e ottimizzato il flusso di lavoro, gestito i conflitti, rimosso gli ostacoli e curato i backlog.',
    'Ho coordinato gli stakeholder interni e facilitato la comunicazione tra Leadership e team, perché stato, obiettivi e ostacoli dei progetti fossero chiari a tutti.',
    'Ho seguito il product management di una piattaforma digitale per servizi no profit, dall\'analisi dei requisiti al rilascio, con il team di sviluppo e a contatto diretto con il cliente.',
    'Ho supervisionato una piattaforma di ticketing B2B, con reportistica su KPI operativi e soddisfazione del cliente.'] },
  { quando: '2022 – 2023', ruolo: 'Solution Designer', dove: 'DM Cultura (oggi Dot Beyond)', punti: [
    'Ho raccolto le esigenze dei clienti e le ho tradotte in requisiti e scenari di implementazione, per commesse di medio-alta complessità.',
    'Ho definito soluzioni e priorità con consulenti esterni e team interni, fino al rilascio.',
    'Ho monitorato i progetti in corso, verificando la coerenza tra obiettivi, tempi e risultati attesi, e fatto scouting di nuove piattaforme e tecnologie.'] },
  { quando: '2019 – 2022', ruolo: 'Research Team Leader and Project Support', dove: 'Expertlab', punti: [
    'Ho definito i requisiti e coordinato gli sviluppatori interni, con responsabilità su qualità e tempi di consegna.',
    'Ho condotto studi di fattibilità e progettato prototipi di soluzioni tecnologiche innovative.',
    'Ho curato la documentazione tecnico-scientifica di progetti IT e di ricerca, alcuni in partnership con ESA (ARIES, HERMES).'] },
  { quando: '2017 – 2019', ruolo: 'Technical Writer, Industry', dove: 'Sfera – Engineering Solutions', punti: [
    'Ho preparato i fascicoli tecnici per la marcatura CE di macchinari e attrezzature a pressione (PED), curando la conformità normativa.',
    'Ho redatto e rivisto relazioni tecniche su verifiche e messa in servizio di attrezzature e insiemi a pressione, controlli spessimetrici a ultrasuoni ed esami magnetoscopici.',
    'Ho elaborato schemi P&I in CAD e la documentazione tecnica per diversi servizi di ingegneria.'] },
  { quando: '2013 – 2018', ruolo: 'Researcher and GIS Analyst', dove: 'Servizio Sanitario Regionale del Lazio – DEP', punti: [
    'Ho svolto analisi quantitative dei dati e modellazione della dispersione di inquinanti in atmosfera.',
    'Ho fatto analisi territoriali con strumenti GIS e prodotto mappe tematiche.',
    'Sono co-autrice di articoli su riviste internazionali peer-reviewed e ho presentato i risultati a conferenze di epidemiologia ambientale.'] },
];
const formazione = [
  { titolo: 'Abilitazione come Perito Industriale', dove: 'Specializzazione in Fisica industriale' },
  { titolo: 'Laurea in Fisica', dove: 'Università degli Studi di Roma Tor Vergata · 100/110' },
  { titolo: 'Maturità scientifica', dove: 'Liceo Scientifico Enrico Fermi, Sulmona · 100/100' },
];
const certificazioni = [
  { nome: 'ICAgile Certified Professional – Agile Team Facilitation (ICP-ATF)', ente: 'ICAgile' },
  { nome: 'Certified ScrumMaster (CSM)', ente: 'Scrum Alliance' },
  { nome: 'Professional Scrum Master I (PSM I)', ente: 'Scrum.org' },
  { nome: 'Agile Scrum Product Owner', ente: 'EXIN' },
];
const pubblicazioni = [
  { titolo: 'Exposure to Residential Greenness as a Predictor of Cause-Specific Mortality and Stroke Incidence in the Rome Longitudinal Study', rivista: 'Environmental Health Perspectives, 2019', doi: 'https://doi.org/10.1289/EHP2854' },
  { titolo: 'La valutazione dell\'esposizione a contaminanti ambientali: modelli di dispersione e biomonitoraggio umano', rivista: 'Epidemiologia e Prevenzione, 2019', doi: 'https://doi.org/10.19191/EP19.4.P260.076' },
  { titolo: 'Long-term exposure to air pollutants from multiple sources and mortality in an industrial area: a cohort study', rivista: 'Occupational and Environmental Medicine, 2019', doi: 'https://doi.org/10.1136/oemed-2018-105059' },
];
---
<Base titolo="Percorso">
  <p class="eyebrow">Percorso</p>
  <h1>Da dove vengo</h1>
  <p class="lead">Dalla ricerca scientifica al product management e alla facilitazione organizzativa: il filo rosso è usare i dati e il pensiero critico per prendere decisioni migliori.</p>

  <h2>Esperienza</h2>
  <div class="timeline">
    {esperienze.map((e) => (
      <article>
        <span class="when">{e.quando}</span>
        <h3>{e.ruolo} · {e.dove}</h3>
        <ul>{e.punti.map((p) => <li>{p}</li>)}</ul>
      </article>
    ))}
  </div>

  <h2>Formazione</h2>
  <div class="grid">
    {formazione.map((f) => (
      <div class="card"><h3>{f.titolo}</h3><p>{f.dove}</p></div>
    ))}
  </div>

  <h2>Certificazioni</h2>
  <div class="grid">
    {certificazioni.map((c) => (
      <div class="card"><h3>{c.nome}</h3><p>{c.ente}</p></div>
    ))}
  </div>

  <h2>Pubblicazioni</h2>
  <ul class="prose">
    {pubblicazioni.map((p) => (
      <li><a href={p.doi}>{p.titolo}</a>. <em>{p.rivista}</em></li>
    ))}
  </ul>
</Base>
