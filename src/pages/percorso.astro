---
import Base from '../layouts/Base.astro';
const esperienze = [
  { quando: '2025 – oggi', ruolo: 'Organizational Facilitator · Scrum Master', dove: 'Eurobet, Entain', punti: [
    'Facilito il processo decisionale strategico tra Leadership e funzioni per identificare valore e ricavo atteso.',
    'Realizzo roadmap e dashboard di avanzamento a livello di tribe; costruisco con team e Product Owner roadmap ibride a milestone e rolling wave.',
    'Progetto e conduco workshop con Executive e Leadership per ridurre i silos e migliorare i processi decisionali.',
    'Coordino team cross-funzionali in contesto internazionale e faccio leadership coaching sull\'allineamento strategico.',
    'Lavoro con le principali metriche agili in uso in azienda per individuare le aree di miglioramento di team e processi.'] },
  { quando: '2023 – 2025', ruolo: 'Scrum Master · Product Manager', dove: 'Dot Beyond', punti: [
    'Ho supportato più team nell\'applicazione di Scrum, dalla Sprint Planning alle Retrospettive.',
    'Product management di una piattaforma digitale per servizi no profit, dai requisiti al rilascio.',
    'Supervisione di una piattaforma di ticketing B2B con reportistica su KPI operativi e soddisfazione del cliente.'] },
  { quando: '2022 – 2023', ruolo: 'Solution Design Specialist · Project Support', dove: 'DM Cultura', punti: [
    'Raccolta esigenze, analisi dei requisiti e valutazione degli scenari per commesse di medio-alta complessità.',
    'Scouting di nuove piattaforme e tecnologie.'] },
  { quando: '2019 – 2022', ruolo: 'Research Team Leader · Project Support', dove: 'Expertlab', punti: [
    'Definizione dei requisiti e coordinamento di sviluppatori interni, con responsabilità su qualità e tempi.',
    'Documentazione tecnico-scientifica per progetti IT e di ricerca, alcuni in partnership con ESA.'] },
  { quando: '2017 – 2019', ruolo: 'Technical Back Office Industry', dove: 'Sfera – Engineering Solutions', punti: [
    'Gestione documentale e tecnica di progetti industriali e fascicoli tecnici per la marcatura CE.'] },
  { quando: '2013 – 2017', ruolo: 'R&D Technical Assistant · GIS Analyst', dove: 'Servizio Sanitario Regionale del Lazio – DEP', punti: [
    'Analisi quantitativa dei dati e modellazione della dispersione di inquinanti in atmosfera.',
    'Co-autrice di articoli su riviste internazionali peer-reviewed e relatrice a conferenze di epidemiologia ambientale.'] },
];
const formazione = [
  { titolo: 'Abilitazione come Perito Industriale', dove: 'Specializzazione in Fisica industriale' },
  { titolo: 'Laurea in Fisica', dove: 'Università degli Studi di Roma Tor Vergata · 100/110' },
  { titolo: 'Maturità scientifica', dove: 'Liceo Scientifico Enrico Fermi, Sulmona · 100/100' },
];
const certificazioni = [
  { nome: 'ICAgile Certified Professional – Agile Team Facilitation (ICP-ATF)', ente: 'ICAgile' },
  { nome: 'Certified ScrumMaster (CSM)', ente: 'Scrum Alliance' },
  { nome: 'Professional Scrum Master I (PSM I)', ente: 'Scrum.org' },
  { nome: 'Agile Scrum Product Owner', ente: 'EXIN' },
];
const pubblicazioni = [
  { titolo: 'Exposure to Residential Greenness as a Predictor of Cause-Specific Mortality and Stroke Incidence in the Rome Longitudinal Study', rivista: 'Environmental Health Perspectives, 2019', doi: 'https://doi.org/10.1289/EHP2854' },
  { titolo: 'La valutazione dell\'esposizione a contaminanti ambientali: modelli di dispersione e biomonitoraggio umano', rivista: 'Epidemiologia e Prevenzione, 2019', doi: 'https://doi.org/10.19191/EP19.4.P260.076' },
  { titolo: 'Long-term exposure to air pollutants from multiple sources and mortality in an industrial area: a cohort study', rivista: 'Occupational and Environmental Medicine, 2019', doi: 'https://doi.org/10.1136/oemed-2018-105059' },
];
---
<Base titolo="Percorso">
  <p class="eyebrow">Percorso</p>
  <h1>Da dove vengo</h1>
  <p class="lead">Dalla ricerca scientifica al product management e alla facilitazione organizzativa: il filo rosso è usare i dati e il pensiero critico per prendere decisioni migliori.</p>

  <h2>Esperienza</h2>
  <div class="timeline">
    {esperienze.map((e) => (
      <article>
        <span class="when">{e.quando}</span>
        <h3>{e.ruolo} · {e.dove}</h3>
        <ul>{e.punti.map((p) => <li>{p}</li>)}</ul>
      </article>
    ))}
  </div>

  <h2>Formazione</h2>
  <div class="grid">
    {formazione.map((f) => (
      <div class="card"><h3>{f.titolo}</h3><p>{f.dove}</p></div>
    ))}
  </div>

  <h2>Certificazioni</h2>
  <div class="grid">
    {certificazioni.map((c) => (
      <div class="card"><h3>{c.nome}</h3><p>{c.ente}</p></div>
    ))}
  </div>

  <h2>Pubblicazioni</h2>
  <ul class="prose">
    {pubblicazioni.map((p) => (
      <li><a href={p.doi}>{p.titolo}</a>. <em>{p.rivista}</em></li>
    ))}
  </ul>
</Base>
